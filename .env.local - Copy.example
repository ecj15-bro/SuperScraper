# ── Database ────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@ep-xxx.neon.tech/neondb?sslmode=require

# ── AI ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Search ──────────────────────────────────────────────────
SERPER_API_KEY=...

# ── Email delivery (optional) ───────────────────────────────
RESEND_API_KEY=re_...
RESEND_FROM=reports@yourdomain.com
REPORT_TO_EMAIL=you@yourdomain.com
ENABLE_EMAIL_DELIVERY=false

# ── Teams webhook (optional) ────────────────────────────────
TEAMS_WEBHOOK_URL=

# ── Slack alerts (optional) ─────────────────────────────────
SLACK_WEBHOOK_URL=

# ── Inngest ─────────────────────────────────────────────────
INNGEST_EVENT_KEY=...
INNGEST_SIGNING_KEY=...

# ── Cron security ───────────────────────────────────────────
# Generate with: openssl rand -hex 32
CRON_SECRET=...

# ── Pipeline tuning ─────────────────────────────────────────
NEWS_MAX_AGE_DAYS=30
MAX_ENRICHMENT_AGE_DAYS=180
ALERT_VALUE_THRESHOLD=100000
ENABLE_LLM_CLASSIFICATION=true
